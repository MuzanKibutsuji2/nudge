{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "tests/**/*.ts",
    "lib/microActions.ts",
    "lib/analytics.ts",
    "lib/taskUtils.ts",
    "lib/phrasing.ts",
    "lib/time.ts",
    "lib/id.ts",
    "lib/sessionTime.ts",
    "types/**/*.ts",
    "constants/palette.ts"
  ]
}
